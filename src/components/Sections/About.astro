---
import Section from "../Section.astro";

const { content } = Astro.props;
---

<Section
  id="about"
  eyebrow={content.eyebrow}
  title={content.title}
  tone="cream"
>
  <div class="grid gap-8 sm:gap-[8vw] md:grid-cols-2">
    <div class="about-lead">
      <p
        class="m-0 max-w-[16ch] font-display text-[clamp(1.8rem,3vw,3rem)] leading-tight"
      >
        {content.lead}
      </p>
    </div>
    <div class="max-w-[58ch] text-[1.05rem] leading-7">
      <p class="mt-0">
        {content.firstParagraph}
      </p>
      <p class="mt-6">
        {content.bookIntro}
        <em>{content.bookTitle}</em>, {content.bookText}
      </p>
      <p class="mt-6">
        {content.finalParagraph}
      </p>
    </div>
  </div>
</Section>
