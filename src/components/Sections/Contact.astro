---
import Section from "../Section.astro";
---

<Section
  id="contact"
  eyebrow="05 / Contact"
  title="Let's continue the conversation."
  tone="cream"
>
  <div class="grid gap-8 sm:gap-[8vw] md:grid-cols-2">
    <div>
      <p
        class="m-0 max-w-[16ch] font-display text-[clamp(1.8rem,3vw,3rem)] leading-tight"
      >
        For questions about research, teaching, or collaboration, get in touch.
      </p>
      <a
        class="mt-8 inline-block border-b border-current pb-1 text-[clamp(1rem,2vw,1.4rem)] no-underline"
        href="mailto:handy.acosta.cuellar@tulane.edu"
        >handy.acosta.cuellar@tulane.edu</a
      >
    </div>
    <address class="text-base not-italic leading-relaxed">
      Handy Acosta Cuellar<br />
      Newcomb Hall 302<br />
      School of Liberal Arts<br />
      Tulane University<br />
      New Orleans, LA 70118
    </address>
  </div>
</Section>
