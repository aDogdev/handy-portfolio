---
import Layout from "../../layouts/Layout.astro";
import About from "../../components/Sections/About.astro";
import Contact from "../../components/Sections/Contact.astro";
import Hero from "../../components/Sections/Hero.astro";
import ResearchThemes from "../../components/Sections/ResearchThemes.astro";
import TeachingPedagogy from "../../components/Sections/TeachingPedagogy.astro";
import { homeData } from "../../data/home";

const content = homeData.es;
---

<Layout lang="es">
  <main>
    <Hero content={content.hero} />
    <About content={content.about} />
    <ResearchThemes content={content.researchThemes} />
    <TeachingPedagogy content={content.teachingPedagogy} />
    <Contact content={content.contact} />
  </main>
</Layout>
