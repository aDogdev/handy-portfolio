---
import Layout from "../../layouts/Layout.astro";

const courses = [
  [
    "Spanish 1010, 2030",
    "Introductory and Intermediate Spanish",
    "Tulane University",
    "https://handyacosta.wordpress.com/wp-content/uploads/2025/10/spring_2025.pdf",
  ],
  [
    "Spanish 1101, 1102, 2101, 2202",
    "Introductory and Intermediate Spanish",
    "Louisiana State University",
    "https://handyacosta.wordpress.com/wp-content/uploads/2025/10/fall-2020-report-for-span-2101-section-003-intermed-spanish-handy-acosta-cuellar_57fc8480-10dc-4d3b-89d5-b87cf99c4f46en-us.pdf",
  ],
  [
    "HSS 1000",
    "Introduction to Research in the Humanities",
    "Louisiana State University",
    "",
  ],
  [
    "SPAN 3070",
    "Spanish for the Professions with Service-Learning",
    "Louisiana State University",
    "https://handyacosta.wordpress.com/wp-content/uploads/2025/10/span3070_syllabus_spring2021-acosta-sl.doc",
  ],
  [
    "LAST 1020",
    "Introduction to Latin American Studies with Service-Learning",
    "Tulane University",
    "https://handyacosta.wordpress.com/wp-content/uploads/2025/10/syllabus-intro-to-latin-american-studies-1020-spring-2018.docx",
  ],
  [
    "LAST 1010",
    "Introduction to Latin American Studies",
    "Tulane University",
    "https://handyacosta.wordpress.com/wp-content/uploads/2025/10/fall2017syllabus-acosta.docx",
  ],
];
---

<Layout>
  <main class="bg-paper">
    <header
      class="min-h-[76vh] bg-rust px-5 pb-24 pt-48 text-paper sm:px-[8vw] lg:px-36"
    >
      <p class="mb-6 text-[.7rem] font-bold uppercase tracking-[.12em]">
        Teaching & pedagogy
      </p>
      <h1
        class="my-8 max-w-[10ch] text-[clamp(4rem,10vw,10rem)] leading-[.88] tracking-[-.05em]"
      >
        The classroom as a place for connection.
      </h1>
      <p
        class="m-0 max-w-[26ch] font-display text-[clamp(1.5rem,3vw,2.5rem)] leading-tight"
      >
        I connect language, history, and community engagement to help students
        read the world with curiosity and care.
      </p>
    </header>

    <section class="px-5 py-20 sm:px-[8vw] sm:py-36 lg:px-36">
      <div class="mx-auto grid max-w-7xl gap-8 sm:gap-[8vw] md:grid-cols-2">
        <h2
          class="m-0 max-w-[10ch] text-[clamp(2.5rem,5vw,5rem)] leading-[.95]"
        >
          Learning is an active, intercultural practice.
        </h2>
        <div class="max-w-[55ch] text-[1.05rem] leading-7">
          <p>
            I have taught different levels of Spanish language, Research in the
            Humanities, and Latin American Studies. My teaching emphasizes
            intercultural competence, critical thinking, and community
            engagement.
          </p>
          <p>
            Service-learning and public-facing pedagogy connect classroom
            inquiry to broader questions of justice, sustainability, and
            belonging.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-cream px-5 py-20 sm:px-[8vw] sm:py-36 lg:px-36">
      <p class="mb-6 text-[.7rem] font-bold uppercase tracking-[.12em]">
        Courses taught
      </p>
      <div class="mx-auto max-w-7xl">
        {
          courses.map(([code, name, institution, href]) => (
            <article class="grid items-start gap-2 border-t border-ink/20 py-6 md:grid-cols-[minmax(10rem,1fr)_3fr_auto] md:items-center md:gap-8">
              <p class="m-0 text-[.7rem] font-bold uppercase tracking-[.12em]">
                {code}
              </p>
              <div>
                <h2 class="m-0 mb-2 max-w-[28ch] text-[clamp(1.8rem,3vw,3.2rem)] leading-none">
                  {name}
                </h2>
                <p class="m-0 leading-relaxed">{institution}</p>
              </div>
              {href && (
                <a
                  class="inline-flex w-fit gap-4 whitespace-nowrap border-b border-current pb-1 text-[.75rem] font-bold uppercase tracking-[.08em] no-underline hover:border-coral hover:text-coral"
                  href={href}
                  target="_blank"
                  rel="noreferrer"
                >
                  Materials <span aria-hidden="true">↗</span>
                </a>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <section
      class="bg-rust px-5 py-20 text-paper sm:px-[8vw] sm:py-36 lg:px-36"
    >
      <div class="mx-auto grid max-w-7xl gap-8 sm:gap-[8vw] md:grid-cols-2">
        <h2
          class="m-0 max-w-[10ch] text-[clamp(2.5rem,5vw,5rem)] leading-[.95]"
        >
          Teaching with the wider world in view.
        </h2>
        <p class="max-w-[55ch] text-[1.05rem] leading-7">
          Open educational resources, service-learning, and student research
          create routes between academic knowledge and the communities that give
          it meaning.
        </p>
      </div>
    </section>
  </main>
</Layout>
