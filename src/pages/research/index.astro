---
import Layout from "../../layouts/Layout.astro";
import { researchData } from "../../data/research";

const { publications, projects } = researchData.en;
---

<Layout>
  <main class="bg-paper">
    <header
      class="min-h-[76vh] bg-ink px-5 pb-24 pt-48 text-paper sm:px-[8vw] lg:px-36"
    >
      <p class="mb-6 text-[.7rem] font-bold uppercase tracking-[.12em]">
        Research
      </p>
      <h1
        class="my-8 max-w-[10ch] text-[clamp(4rem,10vw,10rem)] leading-[.88] tracking-[-.05em]"
      >
        Tracing the lives of materials, people, and ideas.
      </h1>
      <p
        class="m-0 max-w-[26ch] font-display text-[clamp(1.5rem,3vw,2.5rem)] leading-tight"
      >
        My research examines how Afrodescendant, Indigenous, and local actors
        shaped extractive worlds across the early Caribbean.
      </p>
    </header>

    <section class="px-5 py-20 sm:px-[8vw] sm:py-36 lg:px-36">
      <p class="mb-6 text-[.7rem] font-bold uppercase tracking-[.12em]">
        Current frame
      </p>
      <div class="mx-auto grid max-w-7xl gap-8 sm:gap-[8vw] md:grid-cols-2">
        <h2
          class="m-0 max-w-[10ch] text-[clamp(2.5rem,5vw,5rem)] leading-[.95]"
        >
          Exchange, resilience, and equity are connected histories.
        </h2>
        <div class="max-w-[55ch] text-[1.05rem] leading-7">
          <p>
            My work follows copper, sugar, and other commodities as they linked
            Caribbean communities to imperial and global markets. I trace not
            only flows of metals and goods, but also the circulation of
            technologies, beliefs, and survival strategies.
          </p>
          <p>
            Environmental history helps me ask how communities responded to
            extractive pressure, while archival silences and community voices
            open questions about justice, rights, and access.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-cream px-5 py-20 sm:px-[8vw] sm:py-36 lg:px-36">
      <p class="mb-6 text-[.7rem] font-bold uppercase tracking-[.12em]">
        Selected work
      </p>
      <div class="mx-auto max-w-7xl">
        {
          publications.map((publication) => (
            <article class="border-t border-ink/20 py-8">
              <p class="m-0 text-[.7rem] font-bold uppercase tracking-[.12em]">
                {publication.type}
              </p>
              <h2 class="my-2 max-w-[28ch] text-[clamp(1.8rem,3vw,3.2rem)] leading-none">
                <a
                  class="no-underline hover:text-coral"
                  href={publication.href}
                  target="_blank"
                  rel="noreferrer"
                >
                  {publication.title} <span aria-hidden="true">↗</span>
                </a>
              </h2>
              <p class="m-0 leading-relaxed">{publication.detail}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="px-5 py-20 sm:px-[8vw] sm:py-36 lg:px-36">
      <p class="mb-6 text-[.7rem] font-bold uppercase tracking-[.12em]">
        In progress
      </p>
      <div class="mx-auto grid max-w-7xl grid-cols-1 md:grid-cols-3">
        {
          projects.map(([title, text]) => (
            <article class="border-t border-ink/20 py-6 pr-8 md:[&:not(:first-child)]:border-l md:[&:not(:first-child)]:pl-8">
              <h2 class="my-2 max-w-[28ch] text-[clamp(1.6rem,2.5vw,2.5rem)] leading-none">
                {title}
              </h2>
              <p class="m-0 leading-relaxed">{text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="bg-ink px-5 py-20 text-paper sm:px-[8vw] sm:py-36 lg:px-36">
      <p class="mb-6 text-[.7rem] font-bold uppercase tracking-[.12em]">
        Networks & service
      </p>
      <div class="mx-auto grid max-w-7xl gap-8 sm:gap-[8vw] md:grid-cols-2">
        <h2
          class="m-0 max-w-[10ch] text-[clamp(2.5rem,5vw,5rem)] leading-[.95]"
        >
          Research travels through collaboration.
        </h2>
        <div class="max-w-[55ch] text-[1.05rem] leading-7">
          <p>
            Member of TextDiveGlobal and Seminario Iberoamérica Global.
            Professional memberships include IUCN's Commission on Education and
            Communication, LASA, ASEH, the Association of Caribbean Historians,
            and SOLCHA.
          </p>
          <a
            class="mt-8 inline-flex gap-4 border-b border-current pb-1 text-[.75rem] font-bold uppercase tracking-[.08em] no-underline hover:border-coral hover:text-coral"
            href="/#contact"
            >Start a conversation <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </section>
  </main>
</Layout>
