---
import "../styles/global.css";
import { siteData } from "../data/site";

const { lang = "en" } = Astro.props;
const isSpanish = lang === "es";
const siteContent = isSpanish ? siteData.es : siteData.en;
const currentPath = Astro.url.pathname;
const languagePath = isSpanish
  ? currentPath.replace(/^\/es(?=\/|$)/, "") || "/"
  : currentPath === "/"
    ? "/es/"
    : `/es${currentPath}`;
const labels = isSpanish
  ? {
      about: "Sobre mí",
      research: "Investigación",
      teaching: "Docencia",
      contact: "Contacto",
      switch: "EN",
      home: "/es/",
    }
  : {
      about: "About",
      research: "Research",
      teaching: "Teaching",
      contact: "Contact",
      switch: "ES",
      home: "/",
    };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={siteContent.description} />
    <title>Handy Acosta Cuellar, Ph.D.</title>
  </head>
  <body>
    <header
      class:list={[
        "fixed inset-x-0 top-0 z-10 flex items-center justify-between gap-4 bg-paper/90 px-5 py-6 text-ink shadow-sm backdrop-blur-sm sm:gap-8 sm:px-[5vw] lg:px-20",
      ]}
    >
      <a class="font-bold tracking-[.04em] no-underline" href={labels.home}
        >HAC.</a
      >
      <nav class="flex gap-3 sm:gap-8 lg:gap-10" aria-label="Main navigation">
        <a
          class="text-[.62rem] font-bold uppercase tracking-[.1em] no-underline hover:text-coral sm:text-[.75rem]"
          href={`${labels.home}#about`}>{labels.about}</a
        >
        <a
          class="text-[.62rem] font-bold uppercase tracking-[.1em] no-underline hover:text-coral sm:text-[.75rem]"
          href={`${labels.home}#research`}>{labels.research}</a
        >
        <a
          class="text-[.62rem] font-bold uppercase tracking-[.1em] no-underline hover:text-coral sm:text-[.75rem]"
          href={`${labels.home}#teaching`}>{labels.teaching}</a
        >
        <a
          class="text-[.62rem] font-bold uppercase tracking-[.1em] no-underline hover:text-coral sm:text-[.75rem]"
          href={`${labels.home}#contact`}>{labels.contact}</a
        >
      </nav>
      <a
        class="hidden border-b border-current pb-1 text-[.75rem] font-bold uppercase tracking-[.1em] no-underline hover:text-coral sm:block"
        href={languagePath}
        lang={isSpanish ? "en" : "es"}>{labels.switch}</a
      >
    </header>
    <slot />
    <footer
      class="flex justify-between gap-4 px-5 py-6 text-[.75rem] uppercase tracking-[.08em] sm:px-[5vw] lg:px-20"
    >
      <span>Handy Acosta Cuellar, Ph.D.</span>
      <a class="no-underline" href="#top">{siteContent.backToTop}</a>
    </footer>
  </body>
</html>
